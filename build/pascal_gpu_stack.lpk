<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="4">
    <PathDelim Value="/"/>
    <Name Value="pascal_gpu_stack"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="SNAPKITTYWEST"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="/"/>
      <SearchPaths>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
        <IncludeFiles Value="src/core;src/memory;src/device;src/kernel;src/execution;src/sync;src/numerical;src/matrix;src/advanced;src/tests;src/integration"/>
        <OtherUnitFiles Value="src/core;src/memory;src/device;src/kernel;src/execution;src/sync;src/numerical;src/matrix;src/advanced;src/tests;src/integration"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <SyntaxMode Value="ObjFPC"/>
          <UseAnsiStrings Value="True"/>
        </SyntaxOptions>
      </Parsing>
    </CompilerOptions>
    <Description Value="500-block pure Pascal replacement for a CUDA GPU computation stack. Covers device management, memory subsystem, kernel dispatch, synchronization primitives, numerical operations, matrix algebra, tensor operations, optimizer steps, and a full test harness — written entirely in Free Pascal with no CUDA, C, or C++ dependency."/>
    <License Value="MIT"/>
    <Version Major="1" Minor="0" Release="0"/>
    <Files Count="11">
      <Item1>
        <Filename Value="src/core/PascalGPU_Types.pas"/>
        <UnitName Value="PascalGPU_Types"/>
      </Item1>
      <Item2>
        <Filename Value="src/memory/PascalGPU_Memory.pas"/>
        <UnitName Value="PascalGPU_Memory"/>
      </Item2>
      <Item3>
        <Filename Value="src/device/PascalGPU_Device.pas"/>
        <UnitName Value="PascalGPU_Device"/>
      </Item3>
      <Item4>
        <Filename Value="src/kernel/PascalGPU_Kernel.pas"/>
        <UnitName Value="PascalGPU_Kernel"/>
      </Item4>
      <Item5>
        <Filename Value="src/execution/PascalGPU_Execution.pas"/>
        <UnitName Value="PascalGPU_Execution"/>
      </Item5>
      <Item6>
        <Filename Value="src/sync/PascalGPU_Sync.pas"/>
        <UnitName Value="PascalGPU_Sync"/>
      </Item6>
      <Item7>
        <Filename Value="src/numerical/PascalGPU_Numerical.pas"/>
        <UnitName Value="PascalGPU_Numerical"/>
      </Item7>
      <Item8>
        <Filename Value="src/matrix/PascalGPU_Matrix.pas"/>
        <UnitName Value="PascalGPU_Matrix"/>
      </Item8>
      <Item9>
        <Filename Value="src/advanced/PascalGPU_Advanced.pas"/>
        <UnitName Value="PascalGPU_Advanced"/>
      </Item9>
      <Item10>
        <Filename Value="src/tests/PascalGPU_Tests.pas"/>
        <UnitName Value="PascalGPU_Tests"/>
      </Item10>
      <Item11>
        <Filename Value="src/integration/PascalGPU_Integration.pas"/>
        <UnitName Value="PascalGPU_Integration"/>
      </Item11>
    </Files>
    <RequiredPkgs Count="2">
      <Item1>
        <PackageName Value="FCL"/>
      </Item1>
      <Item2>
        <PackageName Value="LazUtils"/>
        <MinVersion Major="1" Valid="True"/>
      </Item2>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
